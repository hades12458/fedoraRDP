# =============================================================
# Configuration Thin Client Fedora → PC Windows 10/11
# Fichier déployé dans : /etc/kiosk-rdp/config
# =============================================================

# --- OBLIGATOIRE : à remplir avant le premier boot ---

# IP ou nom du PC Windows cible (ex: 192.168.1.50)
RDP_SERVER="192.168.1.XXX"

# Compte Windows local sur le PC cible
# (Paramètres Windows → Comptes → ton nom d'utilisateur)
RDP_USER="Prenom"
RDP_PASSWORD="ton_mot_de_passe_windows"

# Domaine : laisser vide pour un compte local Windows (workgroup)
RDP_DOMAIN=""

# Port RDP (3389 par défaut, ne pas changer sauf config spéciale)
RDP_PORT="3389"

# --- Options ---

# Kerberos/AD : désactivé (pas d'AD)
USE_KERBEROS=false

# Reconnexion auto
RECONNECT_DELAY=5          # secondes entre deux tentatives
MAX_RECONNECT_ATTEMPTS=0   # 0 = infini

# Multi-écrans (true uniquement si le PC Windows a plusieurs écrans)
MULTIMON=false

# Audio depuis le PC Windows vers ce Fedora
# remote = son joué ici | off = pas de son
AUDIO_MODE="remote"

# Copier/coller entre les deux machines
CLIPBOARD=true

# RD Gateway : désactivé (connexion directe LAN)
USE_GATEWAY=false
GATEWAY_HOST=""
